<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <CodeSigningTimestampServer Condition="'$(CodeSigningTimestampServer)' == ''">http://time.certum.pl/</CodeSigningTimestampServer>
    <RequireCodeSigning Condition="'$(RequireCodeSigning)' == ''">false</RequireCodeSigning>
  </PropertyGroup>
  <Target Name="SignOutput" AfterTargets="Link" Condition="'$(SkipCodeSigning)' != 'true'">
    <PropertyGroup>
      <_CodeSigningArguments>-Path &quot;$(TargetPath)&quot;</_CodeSigningArguments>
      <_CodeSigningDescription>$(TargetPath)</_CodeSigningDescription>
      <_CodeSigningArguments Condition="'$(CodeSigningBatch)' != ''">-Batch &quot;$(CodeSigningBatch)&quot;</_CodeSigningArguments>
      <_CodeSigningDescription Condition="'$(CodeSigningBatch)' != ''">the $(CodeSigningBatch) batch</_CodeSigningDescription>
    </PropertyGroup>
    <Exec Command="powershell.exe -NoProfile -NonInteractive -File &quot;$(MSBuildThisFileDirectory)CodeSigning.ps1&quot; $(_CodeSigningArguments) -TimestampServer &quot;$(CodeSigningTimestampServer)&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_CodeSigningExitCode" />
    </Exec>
    <Warning Condition="'$(_CodeSigningExitCode)' != '0' And '$(RequireCodeSigning)' != 'true'" Text="Code signing failed or was unavailable for $(_CodeSigningDescription). The build will continue with the generated output." />
    <Error Condition="'$(_CodeSigningExitCode)' != '0' And '$(RequireCodeSigning)' == 'true'" Text="Code signing failed or was unavailable for $(_CodeSigningDescription)." />
  </Target>
</Project>
